# Normalize line endings
* text=auto

# Shell scripts must stay LF or they break on Linux/macOS
*.sh text eol=lf
# macOS double-clickable Terminal scripts — must stay LF too
*.command text eol=lf

# Windows scripts stay CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.webp binary
*.mp3 binary
*.wav binary

# Excluded from buyer zips (git archive) — dev-only files
tools/ export-ignore
installer/ export-ignore
.github/ export-ignore
.gitattributes export-ignore

# Optional Skill Library: lives on GitHub, downloaded one skill at a time from
# Settings > Upgrades. Kept out of every zip, installer and DMG.
skills_library/ export-ignore
