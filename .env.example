# DATA — Dashboard for Analytical Thought and Action
# Copy this file to `.env` and fill in what you use. Everything is optional.

# ── Security ──────────────────────────────────────────────────
# Shared secret for the bridge API. Leave empty for localhost-only use.
# If set, every API request must send X-Data-Token: <value> or ?key=<value>.
DATA_BRIDGE_TOKEN=

# ── Lifecycle ─────────────────────────────────────────────────
# daemon = bridge keeps running when you close the browser (default).
#          Standing orders and remote access keep working. Stop DATA on
#          purpose with System Offline in the dashboard.
# auto   = legacy. The bridge exits on its own once the dashboard stops
#          checking in. A busy session can delay that check-in while work
#          is still running, which ends the run early. Not recommended.
# Leave this unset to take the default.
#DATA_LIFECYCLE_MODE=daemon

# ── Port ──────────────────────────────────────────────────────
DATA_PORT=7777
